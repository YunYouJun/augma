{
  "name": "@augma/workspace",
  "type": "module",
  "version": "0.2.3",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm --filter @augma/site dev",
    "dev:ar": "pnpm --filter @augma/ar dev",
    "mac:run": "./script/build_and_run.sh",
    "mac:verify": "./script/build_and_run.sh --verify",
    "mac:package": "./script/build_and_run.sh --package",
    "mac:setup-todo": "node scripts/microsoft-todo.mjs setup",
    "mac:check-todo": "node scripts/microsoft-todo.mjs check",
    "icons:sync": "node scripts/sync-app-icon.mjs",
    "icons:check": "node scripts/sync-app-icon.mjs --check",
    "generate": "node scripts/generate.mjs",
    "plugins:build": "node scripts/build-plugin-catalog.mjs",
    "test:plugins": "node --test tests/plugins/*.test.mjs",
    "build:lib": "pnpm --filter @augma/core build && pnpm --filter augma build",
    "build:site": "pnpm --filter @augma/site build",
    "build:ar": "pnpm --filter @augma/ar build",
    "build:artifacts": "pnpm build:lib && pnpm build:site && pnpm build:ar && node scripts/assemble.mjs",
    "docs:dev": "pnpm dev",
    "docs:build": "pnpm generate && pnpm build:site",
    "build": "pnpm generate && pnpm build:artifacts",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node scripts/verify-packages.mjs",
    "test:registry": "node scripts/verify-registry.mjs",
    "test": "pnpm test:unit && pnpm test:browser",
    "check:generated": "git diff --exit-code -- packages/core/src/tokens.css packages/augma-ui/Sources/AugmaUI/AugmaTokens.swift apps/site/components apps/site/en/components apps/site/ja/components skills/augma/references",
    "check:build": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:plugins && pnpm test:release && pnpm build:artifacts && pnpm test:package && pnpm test:registry",
    "check": "pnpm check:build && pnpm test:browser",
    "test:release": "node --test tests/release/*.test.mjs",
    "release": "bumpp",
    "release:pack": "node scripts/check-release.mjs --prepare && node scripts/release-artifacts.mjs pack",
    "release:verify": "node scripts/release-artifacts.mjs verify",
    "release:check-published": "node scripts/check-published.mjs",
    "i18n:check": "node scripts/check-mac-localizations.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@augma/core": "workspace:*",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/webxr": "^0.5.21",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/compiler-sfc": "3.5.46",
    "@vue/server-renderer": "3.5.46",
    "@vue/test-utils": "2.6.0",
    "augma": "workspace:*",
    "bumpp": "12.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-format": "2.0.1",
    "happy-dom": "21.0.4",
    "reka-ui": "2.11.0",
    "shadcn-vue": "2.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14"
  }
}
