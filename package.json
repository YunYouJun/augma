{
  "name": "@augma/workspace",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @augma/site dev",
    "dev:ar": "pnpm --filter @augma/ar dev",
    "generate": "node scripts/generate.mjs",
    "build:lib": "pnpm --filter @augma/core build && pnpm --filter augma build",
    "build:ar": "pnpm --filter @augma/ar build",
    "docs:dev": "pnpm dev",
    "docs:build": "pnpm generate && pnpm --filter @augma/site build",
    "build": "pnpm build:lib && pnpm docs:build && pnpm build:ar && node scripts/assemble.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node scripts/verify-packages.mjs",
    "test:registry": "node scripts/verify-registry.mjs",
    "test": "pnpm test:unit && pnpm test:browser",
    "check": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:package && pnpm test:registry && pnpm test:browser"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@augma/core": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/webxr": "^0.5.21",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/server-renderer": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "augma": "workspace:*",
    "eslint": "10.11.0",
    "eslint-plugin-format": "2.0.1",
    "happy-dom": "20.14.5",
    "reka-ui": "2.10.5",
    "shadcn-vue": "2.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  }
}
