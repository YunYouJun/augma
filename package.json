{
  "name": "@augma/monorepo",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "author": {
    "name": "YunYouJun",
    "email": "me@yunyoujun.cn",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MIT",
  "repository": "https://github.com/YunYouJun/augma.git",
  "scripts": {
    "build:client": "pnpm -C packages/client build",
    "build:lib": "pnpm -C packages/augma build",
    "build": "pnpm -r --filter=./packages/** --parallel run build",
    "dev": "pnpm -C packages/client dev",
    "docs": "pnpm run docs:dev",
    "docs:dev": "vitepress dev packages --host --port 3002",
    "docs:build": "vitepress build packages",
    "docs:serve": "vitepress serve packages",
    "docs:theme": "cross-env NODE_ENV=dev:theme vitepress dev packages",
    "lint": "eslint .",
    "preinstall": "npm run update",
    "release": "tsx scripts/release.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest",
    "test": "npm run test:unit",
    "update": "tsx scripts/update.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^8.1.1",
    "@vueuse/core": "^13.1.0",
    "prism-theme-vars": "^0.2.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@augma/components": "workspace:*",
    "@augma/metadata": "workspace:*",
    "@augma/types": "workspace:*",
    "@iconify-json/ri": "^1.2.5",
    "@types/markdown-it-container": "^2.0.10",
    "@types/minimist": "^1.2.5",
    "@types/semver": "^7.7.0",
    "@types/webxr": "^0.5.21",
    "@unocss/eslint-config": "^66.1.0-beta.10",
    "@unocss/eslint-plugin": "^66.0.0",
    "augma": "workspace:*",
    "cross-env": "^7.0.3",
    "enquirer": "^2.4.1",
    "eslint": "^9.24.0",
    "eslint-plugin-format": "^1.0.1",
    "execa": "7.1.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "markdown-it-container": "^4.0.0",
    "minimist": "^1.2.8",
    "semver": "^7.7.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "unocss": "^66.1.0-beta.10",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.2.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitepress": "1.6.3",
    "vitest": "^3.1.1"
  }
}
