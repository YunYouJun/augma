{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Resolve @augma/core through its built package rather than the workspace source alias,
    // so the declarations re-export it instead of pulling its source under rootDir.
    "paths": {},
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
