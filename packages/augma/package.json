{
  "name": "augma",
  "type": "module",
  "version": "0.2.0",
  "description": "Lightweight AR-inspired Vue components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/augma.git",
    "directory": "packages/augma"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/build-vue-style.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@augma/core": "workspace:^",
    "reka-ui": "2.10.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
