{
  "font": "'Exo 2', 'Avenir Next', 'PingFang SC', 'Microsoft YaHei', sans-serif",
  "cut": "10px",
  "glassBlur": "18px",
  "motion": {
    "durationMs": 160,
    "durationSlowMs": 420,
    "ease": [0.16, 1, 0.3, 1],
    "easeIn": [0.7, 0, 0.84, 0],
    "easeSpring": [0.34, 1.56, 0.64, 1]
  },
  "colors": {
    "bg": {
      "css": "--agm-bg",
      "light": "#ffffff",
      "dark": "#131e29"
    },
    "surface": {
      "css": "--agm-surface",
      "light": "#f3f6f8",
      "dark": "#1b2936"
    },
    "panel": {
      "css": "--agm-panel",
      "light": "rgb(255 255 255 / 88%)",
      "dark": "rgb(29 44 58 / 92%)"
    },
    "glassBg": {
      "css": "--agm-glass-bg",
      "light": "rgb(255 255 255 / 72%)",
      "dark": "rgb(24 38 52 / 72%)"
    },
    "glassStrong": {
      "css": "--agm-glass-strong",
      "light": "rgb(255 255 255 / 86%)",
      "dark": "rgb(22 35 48 / 88%)"
    },
    "glassBorder": {
      "css": "--agm-glass-border",
      "light": "rgb(38 52 66 / 14%)",
      "dark": "rgb(255 255 255 / 16%)"
    },
    "glassShadow": {
      "css": "--agm-glass-shadow",
      "light": "0 12px 36px rgb(31 54 74 / 12%)",
      "dark": "0 14px 40px rgb(0 0 0 / 34%)"
    },
    "text": {
      "css": "--agm-text",
      "light": "#263442",
      "dark": "#edf4fa"
    },
    "muted": {
      "css": "--agm-muted",
      "light": "#5c7187",
      "dark": "#a0b6c9"
    },
    "border": {
      "css": "--agm-border",
      "light": "#becdda",
      "dark": "#435a6e"
    },
    "accent": {
      "css": "--agm-accent",
      "light": "#b75e08",
      "dark": "#f1a74c",
      "rgb": {
        "light": [183, 94, 8],
        "dark": [241, 167, 76]
      }
    },
    "highlight": {
      "css": "--agm-highlight",
      "light": "#f28c12",
      "dark": "#f28c12",
      "rgb": {
        "light": [242, 140, 18],
        "dark": [242, 140, 18]
      }
    },
    "accentHover": {
      "css": "--agm-accent-hover",
      "light": "#a95706",
      "dark": "#ffbe72"
    },
    "onAccent": {
      "css": "--agm-on-accent",
      "light": "#ffffff",
      "dark": "#172331"
    },
    "cyan": {
      "css": "--agm-cyan",
      "light": "#258ca4",
      "dark": "#67c8da",
      "rgb": {
        "light": [37, 140, 164],
        "dark": [103, 200, 218]
      }
    },
    "success": {
      "css": "--agm-success",
      "light": "#287947",
      "dark": "#7cdaa0",
      "rgb": {
        "light": [40, 121, 71],
        "dark": [124, 218, 160]
      }
    },
    "danger": {
      "css": "--agm-danger",
      "light": "#bc394a",
      "dark": "#ff95a4",
      "rgb": {
        "light": [188, 57, 74],
        "dark": [255, 149, 164]
      }
    },
    "dangerHover": {
      "css": "--agm-danger-hover",
      "light": "#a62f3f",
      "dark": "#ffb0bc"
    },
    "onDanger": {
      "css": "--agm-on-danger",
      "light": "#ffffff",
      "dark": "#240d11"
    },
    "upload": {
      "light": "#1e64c0",
      "dark": "#70afff",
      "rgb": {
        "light": [30, 100, 192],
        "dark": [112, 175, 255]
      }
    },
    "shadow": {
      "css": "--agm-shadow",
      "light": "0 18px 60px rgb(49 82 109 / 10%)",
      "dark": "0 18px 60px rgb(0 0 0 / 25%)"
    },
    "light": {
      "css": "--agm-light",
      "light": "rgb(255 255 255 / 85%)",
      "dark": "rgb(255 255 255 / 10%)"
    },
    "sheen": {
      "css": "--agm-sheen",
      "light": "rgb(255 255 255 / 55%)",
      "dark": "rgb(255 255 255 / 16%)"
    },
    "glow": {
      "css": "--agm-glow",
      "light": "rgb(242 140 18 / 38%)",
      "dark": "rgb(241 167 76 / 34%)"
    }
  }
}
