{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "augma": [
        "packages/augma/src/index.ts"
      ],
      "@augma/core/*": [
        "packages/core/src/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node",
      "webxr"
    ],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/augma/src/**/*.ts",
    "packages/augma/src/**/*.vue",
    "apps/**/*.ts",
    "apps/**/*.vue",
    "examples/**/*.vue",
    "tests/**/*.ts",
    "apps/site/.vitepress/**/*.ts",
    "apps/site/.vitepress/**/*.vue"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/site/.vitepress/cache/**"
  ]
}
