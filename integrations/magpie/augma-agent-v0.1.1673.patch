diff --git a/internal/agent/augma.go b/internal/agent/augma.go
new file mode 100644
index 0000000..7b7dd0a
--- /dev/null
+++ b/internal/agent/augma.go
@@ -0,0 +1,210 @@
+package agent
+
+// Augma exports only runtime, model and effort to this versioned JSON file.
+// Its executable, credentials, consent and test state stay in the native app.
+// Changing a selection invalidates Augma's test; returning to the app imports
+// it and lets the user test and enable it. No DSH desktop profile is edited.
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"unicode"
+
+	"github.com/yetone/magpie/internal/edit"
+)
+
+var augmaEfforts = []string{"none", "off", "minimal", "low", "medium", "high", "xhigh", "max"}
+
+type augmaConfig struct {
+	Version int    `json:"version"`
+	Runtime string `json:"runtime"`
+	Model   string `json:"model"`
+	Effort  string `json:"effort"`
+	Managed bool   `json:"managed"`
+}
+
+func readAugma(path string) (augmaConfig, map[string]json.RawMessage, error) {
+	var c augmaConfig
+	var raw map[string]json.RawMessage
+	b, err := edit.Read(path)
+	if err != nil {
+		return c, nil, err
+	}
+	if len(b) > 65536 || json.Unmarshal(b, &raw) != nil || raw == nil || json.Unmarshal(b, &c) != nil ||
+		c.Version != 1 || (c.Runtime != "dsh" && c.Runtime != "deepseek") || raw["model"] == nil || raw["effort"] == nil ||
+		string(raw["model"]) == "null" || string(raw["effort"]) == "null" || len([]rune(c.Model)) > 512 ||
+		strings.ContainsFunc(c.Model, func(r rune) bool { return unicode.IsSpace(r) || unicode.IsControl(r) }) ||
+		(c.Model != "" && !strings.Contains(c.Model, "/")) || (c.Managed && (c.Runtime != "dsh" || c.Model == "")) ||
+		(c.Effort != "" && !slices.Contains(augmaEfforts, c.Effort)) {
+		return c, nil, fmt.Errorf("Augma configuration is unreadable or unsupported; open a compatible Augma first")
+	}
+	return c, raw, nil
+}
+
+func augma(home string) *Agent {
+	path := filepath.Join(home, "Library", "Application Support", "Augma", "Assistant", "magpie.json")
+	key := "augma:" + path
+	get := func() augmaConfig { c, _, _ := readAugma(path); return c }
+	known := func(ref string) bool {
+		for _, model := range magpieModels("augma") {
+			if model.ID == ref {
+				return true
+			}
+		}
+		return false
+	}
+	restore := func() error {
+		c, _, err := readAugma(path)
+		if err != nil {
+			return err
+		}
+		if !c.Managed {
+			return nil
+		}
+		var had map[string]json.RawMessage
+		if v := stashLoad()[key]; v == "" || json.Unmarshal([]byte(v), &had) != nil || had == nil {
+			return fmt.Errorf("Augma's saved settings are missing; its current configuration was kept")
+		}
+		var kvs []edit.KV
+		var drop []string
+		for _, k := range []string{"runtime", "model", "effort", "managed"} {
+			if v, ok := had[k]; ok {
+				kvs = append(kvs, edit.KV{Path: k, Value: v})
+			} else {
+				drop = append(drop, k)
+			}
+		}
+		if err := edit.DelJSON(path, drop...); err != nil {
+			return err
+		}
+		if err := edit.SetJSON(path, kvs...); err != nil {
+			return err
+		}
+		forget(key)
+		return nil
+	}
+	efforts := func(ref string) []Option {
+		out := []Option{{Value: ""}}
+		for _, m := range magpieModels("augma") {
+			if m.ID != ref {
+				continue
+			}
+			for _, e := range m.Efforts {
+				if slices.Contains(augmaEfforts, e) {
+					out = append(out, Option{Value: e})
+				}
+			}
+		}
+		return out
+	}
+	a := &Agent{ID: "augma", Name: "Augma", Icon: "augma", UA: []string{"augma"}, Path: path, Spelled: prefixed, NoNames: true,
+		detect: func() bool {
+			st, err := os.Stat(path)
+			return runtime.GOOS == "darwin" && err == nil && st.Mode().IsRegular()
+		},
+		Notice: func() string {
+			return noticeAugma.String()
+		},
+		OwnVia: func(model string) string {
+			if known(model) {
+				return magpieID + "/" + model
+			}
+			return ""
+		},
+		Unwire: restore,
+		// No Check: Augma has no gateway address to rewire. DSH owns that
+		// route; this adapter owns only the model and effort selections.
+		Fields: []Field{{Key: "model", Label: "model",
+			Get: func() string {
+				c := get()
+				if c.Managed {
+					return magpieID + "/" + c.Model
+				}
+				return c.Model
+			},
+			Options: func(cur map[string]string) []Option {
+				return append(ownOptions("", cur["model"]), viaMagpie("augma", magpieID+"/")...)
+			},
+			Set: func(v string) error {
+				if v == "" {
+					return restore()
+				}
+				ref, ok := strings.CutPrefix(v, magpieID+"/")
+				if !ok || !known(ref) {
+					return fmt.Errorf("pick an Augma model from magpie's catalog")
+				}
+				c, raw, err := readAugma(path)
+				if err != nil {
+					return err
+				}
+				if !c.Managed {
+					had := map[string]json.RawMessage{}
+					for _, k := range []string{"runtime", "model", "effort", "managed"} {
+						if value, ok := raw[k]; ok {
+							had[k] = value
+						}
+					}
+					b, err := json.Marshal(had)
+					if err != nil {
+						return err
+					}
+					stashMu.Lock()
+					st := stashLoad()
+					st[key] = string(b)
+					err = stashWrite(st)
+					stashMu.Unlock()
+					if err != nil {
+						return err
+					}
+				}
+				effort := c.Effort
+				if !slices.ContainsFunc(efforts(ref), func(o Option) bool { return o.Value == effort }) {
+					effort = ""
+				}
+				return edit.SetJSON(path, edit.KV{Path: "runtime", Value: "dsh"}, edit.KV{Path: "managed", Value: true},
+					edit.KV{Path: "model", Value: ref}, edit.KV{Path: "effort", Value: effort})
+			},
+		}, {Key: "effort", Label: "effort",
+			Get: func() string { return get().Effort },
+			Options: func(map[string]string) []Option {
+				c := get()
+				if !c.Managed {
+					return nil
+				}
+				return efforts(c.Model)
+			},
+			Set: func(v string) error {
+				c, _, err := readAugma(path)
+				if err != nil {
+					return err
+				}
+				if !c.Managed {
+					if v == "" {
+						return nil
+					}
+					return fmt.Errorf("connect Augma to magpie before setting effort")
+				}
+				if !slices.ContainsFunc(efforts(c.Model), func(o Option) bool { return o.Value == v }) {
+					return fmt.Errorf("Augma model %q does not support effort %q", c.Model, v)
+				}
+				return edit.SetJSON(path, edit.KV{Path: "effort", Value: v})
+			},
+		}},
+	}
+	// Connect's generic matching strips provider prefixes. Augma already stores
+	// a complete gateway id, including named groups, so keep that exact selection.
+	a.Join = func() (bool, error) {
+		c := get()
+		if !known(c.Model) {
+			return false, nil
+		}
+		return true, a.Apply("model", magpieID+"/"+c.Model)
+	}
+	return atomic(a, path, stashPath())
+}
+
+var noticeAugma = newNotice("Return to Augma, test the new model and tools, then enable the assistant. Disconnect restores its previous settings.")
diff --git a/internal/agent/augma_test.go b/internal/agent/augma_test.go
new file mode 100644
index 0000000..55b7e82
--- /dev/null
+++ b/internal/agent/augma_test.go
@@ -0,0 +1,136 @@
+package agent
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"slices"
+	"testing"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func augmaFixture(t *testing.T) (*Agent, string) {
+	t.Helper()
+	home, _ := museHome(t)
+	a := augma(home)
+	if err := os.MkdirAll(filepath.Dir(a.Path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	original := `{"version":1,"runtime":"deepseek","model":"group/augma","effort":"medium","future":{"keep":true}}`
+	if err := os.WriteFile(a.Path, []byte(original), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := catalog.SaveLive("fixture", "https://fixture.invalid/v1", []catalog.Model{
+		{ID: "terra", Efforts: []string{"low", "medium", "high", "ultra"}}, {ID: "small", Efforts: []string{"low"}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.Save(provider.Provider{ID: "fixture", Name: "Fixture", Key: "test", Chat: "https://fixture.invalid/v1", Models: []string{"terra", "small"}}); err != nil {
+		t.Fatal(err)
+	}
+	return a, original
+}
+
+func TestAugmaRegistrationAndDetection(t *testing.T) {
+	a, _ := augmaFixture(t)
+	if !slices.ContainsFunc(All(), func(v *Agent) bool { return v.ID == "augma" }) {
+		t.Fatal("Augma missing from agent list")
+	}
+	if a.Detected() != (runtime.GOOS == "darwin") {
+		t.Fatal("wrong platform detection")
+	}
+	if err := os.Remove(a.Path); err != nil {
+		t.Fatal(err)
+	}
+	if a.Detected() {
+		t.Fatal("uninstalled Augma detected")
+	}
+}
+
+func TestAugmaModelEffortAndDisconnect(t *testing.T) {
+	a, original := augmaFixture(t)
+	for range 2 {
+		if err := a.Apply("model", "magpie/fixture/terra"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if a.Field("effort").Get() != "medium" {
+		t.Fatal("user's effort lost")
+	}
+	if err := a.Apply("effort", "high"); err != nil {
+		t.Fatal(err)
+	}
+	if err := a.Field("effort").Set("ultra"); err == nil {
+		t.Fatal("unsupported DSH effort accepted")
+	}
+	if err := a.Apply("model", "magpie/fixture/small"); err != nil {
+		t.Fatal(err)
+	}
+	if a.Field("effort").Get() != "" {
+		t.Fatal("unsupported previous effort retained")
+	}
+	if err := a.Apply("effort", "low"); err != nil {
+		t.Fatal(err)
+	}
+	c, raw, err := readAugma(a.Path)
+	if err != nil || !c.Managed || c.Runtime != "dsh" || c.Model != "fixture/small" || string(raw["future"]) != "{\"keep\":true}" {
+		t.Fatalf("selection: %+v %v", c, err)
+	}
+	if err := a.Disconnect(); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(a.Path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var expected, actual any
+	json.Unmarshal([]byte(original), &expected)
+	json.Unmarshal(got, &actual)
+	if !reflect.DeepEqual(expected, actual) {
+		t.Fatalf("disconnect didn't restore original: %s", got)
+	}
+}
+
+func TestAugmaRejectsInvalidConfigAndUnknownModel(t *testing.T) {
+	a, original := augmaFixture(t)
+	if err := a.Field("model").Set("magpie/fixture/missing"); err == nil {
+		t.Fatal("unknown model accepted")
+	}
+	b, _ := os.ReadFile(a.Path)
+	if string(b) != original {
+		t.Fatal("unknown model changed config")
+	}
+	for _, bad := range []string{
+		"{", `{"version":99,"runtime":"dsh","model":"fixture/terra","effort":"medium"}`,
+		`{"version":1,"runtime":"dsh","model":null,"effort":"medium"}`,
+		`{"version":1,"runtime":"dsh","model":"fixture/terra","effort":null}`,
+		`{"version":1,"runtime":"dsh","model":"fixture/ terra","effort":"medium"}`,
+		`{"version":1,"runtime":"deepseek","model":"fixture/terra","effort":"medium","managed":true}`,
+	} {
+		os.WriteFile(a.Path, []byte(bad), 0o600)
+		if err := a.Field("model").Set("magpie/fixture/terra"); err == nil {
+			t.Fatal("invalid config overwritten")
+		}
+		b, _ := os.ReadFile(a.Path)
+		if string(b) != bad {
+			t.Fatal("invalid config changed")
+		}
+	}
+}
+
+func TestAugmaConnectKeepsExistingGroup(t *testing.T) {
+	a, _ := augmaFixture(t)
+	if err := provider.SaveGroup(provider.Group{ID: "augma", Name: "Augma", Members: []string{"fixture/terra"}}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := a.ConnectHow(); err != nil {
+		t.Fatal(err)
+	}
+	if a.Field("model").Get() != "magpie/group/augma" || a.Field("effort").Get() != "medium" {
+		t.Fatalf("connect changed user's group: %v", a.Values())
+	}
+}
